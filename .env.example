# ==========================================
# General Configurations
# ==========================================
NODE_ENV=development
PORT=5000
APP_NAME="Discord Bot List"
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
API_URL=http://localhost:5000/api
DOMAIN=localhost
COOKIE_DOMAIN=localhost
SESSION_SECRET=super-secret-session-key-change-in-prod
JWT_SECRET=super-secret-jwt-signing-key-change-in-prod
JWT_EXPIRES_IN=7d

# ==========================================
# Database Configuration
# ==========================================
# Use local MongoDB (e.g. mongodb://localhost:27017/discord_bot_list)
MONGODB_URI=mongodb://localhost:27017/discord_bot_list

# ==========================================
# Discord OAuth2 API Configuration
# ==========================================
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=discord-client-secret-here
DISCORD_BOT_TOKEN=discord-bot-token-here
DISCORD_PUBLIC_KEY=discord-public-key-here
DISCORD_REDIRECT_URI=http://localhost:5000/api/auth/discord/callback
DISCORD_INVITE_LINK=https://discord.com/api/oauth2/authorize?client_id=YOUR_CLIENT_ID&permissions=0&scope=bot%20applications.commands

# ==========================================
# SMTP Configuration (Optional: Mail / Verification / Notifications)
# ==========================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=smtp-username
SMTP_PASS=smtp-password
SMTP_FROM="Discord Bot List <noreply@discordbotlist.local>"

# ==========================================
# Storage Providers (R2 / AWS S3)
# ==========================================
# Options: local | r2 | s3
UPLOAD_PROVIDER=local
MAX_FILE_SIZE=5242880

AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_R2_BUCKET=your-r2-bucket-name
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ==========================================
# Monitoring & Logging
# ==========================================
GOOGLE_ANALYTICS_ID=G-XXXXXX
GOOGLE_SITE_VERIFICATION=google-site-verification-code
SENTRY_DSN=https://sentry-dsn-url
LOG_LEVEL=info

# ==========================================
# Security & Integrations
# ==========================================
CRON_SECRET=cron-secret-token-here
WEBHOOK_SECRET=webhook-signing-secret-here
ENCRYPTION_KEY=32-character-long-encryption-key-here
BACKUP_CRON="0 0 * * *"
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=true
FEATURE_FLAGS=enable-reviews:true,enable-api-keys:true
